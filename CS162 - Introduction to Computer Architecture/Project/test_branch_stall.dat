% Test: Branch stalling behavior
% Fetch should stall when 'bne' is decoded until it resolves.
% Only loops 5 times to avoid long execution output.
0, 5
8, 1

addi R1, R0, 5    
fld F0, 0(R0)     
fld F2, 8(R0)     

loop: fadd F0, F0, F2   
addi R1, R1, -1         
bne R1, R0, loop        
fsd F0, 16(R0)          

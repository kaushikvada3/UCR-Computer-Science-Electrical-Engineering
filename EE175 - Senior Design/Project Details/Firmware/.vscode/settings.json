{
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk-rel",
      "command": "latexmk",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-pdf",
        "-outdir=.",
        "%DOCFILE%.tex"
      ]
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "latexmk (relative path)",
      "tools": [
        "latexmk-rel"
      ]
    }
  ]
}
